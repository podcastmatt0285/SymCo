{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "body": [
    {
      "type": "ColumnSet",
      "spacing": "None",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            {
              "type": "TextBlock",
              "text": "WADSWORTH",
              "size": "Small",
              "weight": "Bolder",
              "color": "Accent",
              "spacing": "None"
            },
            {
              "type": "TextBlock",
              "text": "${balance}",
              "size": "ExtraLarge",
              "weight": "Bolder",
              "color": "Default",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "Image",
              "url": "/static/icons/icon-48.png",
              "width": "32px",
              "height": "32px"
            }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "style": "attention",
      "spacing": "Small",
      "bleed": false,
      "items": [
        {
          "type": "TextBlock",
          "text": "🔔 ${last_alert}",
          "size": "Small",
          "wrap": true,
          "maxLines": 2,
          "spacing": "None"
        },
        {
          "type": "TextBlock",
          "text": "${last_alert_time}",
          "size": "Small",
          "isSubtle": true,
          "spacing": "None"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "INDICES",
      "size": "Small",
      "weight": "Bolder",
      "color": "Accent",
      "spacing": "Medium"
    },
    {
      "type": "FactSet",
      "$data": "${indices}",
      "facts": [
        {
          "title": "${label}",
          "value": "${value}  ${change}"
        }
      ],
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "STOCKS",
      "size": "Small",
      "weight": "Bolder",
      "color": "Accent",
      "spacing": "Small"
    },
    {
      "type": "FactSet",
      "$data": "${stocks}",
      "facts": [
        {
          "title": "${label}",
          "value": "${value}  ${change}"
        }
      ],
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "BOND YIELDS",
      "size": "Small",
      "weight": "Bolder",
      "color": "Accent",
      "spacing": "Small"
    },
    {
      "type": "FactSet",
      "$data": "${bonds}",
      "facts": [
        {
          "title": "${label}",
          "value": "${value}"
        }
      ],
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "text": "MEMECOINS",
      "size": "Small",
      "weight": "Bolder",
      "color": "Accent",
      "spacing": "Small"
    },
    {
      "type": "FactSet",
      "$data": "${memes}",
      "facts": [
        {
          "title": "${label}",
          "value": "${value}"
        }
      ],
      "spacing": "None"
    }
  ],
  "actions": [
    {
      "type": "Action.OpenUrl",
      "title": "Open Wadsworth",
      "url": "/"
    }
  ]
}
