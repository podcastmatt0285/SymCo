<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <!-- Header row: WADSWORTH + LIVE -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="WADSWORTH"
            android:textColor="#7dd3fc"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#9679; LIVE"
            android:textColor="#4ade80"
            android:textSize="9sp" />
    </RelativeLayout>

    <!-- Cash balance -->
    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="&#8212;"
        android:textColor="#f8fafc"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Last alert text -->
    <TextView
        android:id="@+id/widget_alert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#cbd5e1"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Alert timestamp -->
    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#64748b"
        android:textSize="9sp" />

    <!-- Spacer before ticker -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="#334155" />

    <!-- Market ticker: marquee scroll activated via setSelected(true) in Java -->
    <TextView
        android:id="@+id/widget_tickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="marquee" />

</LinearLayout>
