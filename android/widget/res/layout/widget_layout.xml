<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header: WADSWORTH + refresh button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="WADSWORTH"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#8635;"
            android:textColor="#22c55e"
            android:textSize="14sp"
            android:padding="2dp" />

    </RelativeLayout>

    <!-- Balance -->
    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="#f1f5f9"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <!-- Notification 1 (most recent) -->
    <TextView
        android:id="@+id/widget_notif1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#cbd5e1"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Notification 2 -->
    <TextView
        android:id="@+id/widget_notif2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Notification 3 -->
    <TextView
        android:id="@+id/widget_notif3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#64748b"
        android:textSize="9sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Tickers -->
    <TextView
        android:id="@+id/widget_tickers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#475569"
        android:textSize="8sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

</LinearLayout>
