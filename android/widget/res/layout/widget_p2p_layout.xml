<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_p2p_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header: title + nav -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="CONTACTS"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <!-- Right side: prev · page indicator · next -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_p2p_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8249;"
                android:textColor="#38bdf8"
                android:textSize="20sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/widget_p2p_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— / —"
                android:textColor="#64748b"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_p2p_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textColor="#38bdf8"
                android:textSize="20sp"
                android:paddingStart="6dp" />

        </LinearLayout>

    </RelativeLayout>

    <!-- Avatar + name row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_p2p_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#38bdf8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/widget_background"
            android:layout_marginEnd="12dp"
            android:text="?" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_p2p_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#e2e8f0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_p2p_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#a5b4fc"
                android:textSize="9sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Stats rows -->
    <TextView
        android:id="@+id/widget_p2p_networth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_p2p_cash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_p2p_debt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_p2p_biz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_p2p_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_p2p_stocks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp"
        android:layout_marginBottom="3dp" />

    <TextView
        android:id="@+id/widget_p2p_contracts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#94a3b8"
        android:textSize="9sp" />

</LinearLayout>
