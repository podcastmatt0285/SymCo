<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_p2p_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- ─── Header: title + pagination ─── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="CONTACTS"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_p2p_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8249;"
                android:textColor="#38bdf8"
                android:textSize="20sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/widget_p2p_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8212; / &#8212;"
                android:textColor="#64748b"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_p2p_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textColor="#38bdf8"
                android:textSize="20sp"
                android:paddingStart="6dp" />

        </LinearLayout>
    </RelativeLayout>

    <!-- Header divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e293b"
        android:layout_marginBottom="8dp" />

    <!-- ─── Identity: avatar + name + level ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_p2p_avatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:textColor="#38bdf8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/widget_avatar_bg"
            android:layout_marginEnd="10dp"
            android:text="?" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_p2p_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="&#8212;"
                android:textColor="#e2e8f0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_p2p_pid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#475569"
                android:textSize="7sp" />

            <TextView
                android:id="@+id/widget_p2p_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#a5b4fc"
                android:textSize="8sp" />

        </LinearLayout>
    </LinearLayout>

    <!-- Founding Tester badge -->
    <TextView
        android:id="@+id/widget_p2p_founding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#fbbf24"
        android:textSize="8sp"
        android:layout_marginBottom="2dp" />

    <!-- Identity divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e293b"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp" />

    <!-- ─── 📊 NET WORTH ─── -->
