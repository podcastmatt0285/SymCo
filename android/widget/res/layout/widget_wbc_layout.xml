<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_wbc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="&#128200; WBC-50"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_wbc_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#8635;"
            android:textColor="#38bdf8"
            android:textSize="13sp" />

    </RelativeLayout>

    <!-- Current value -->
    <TextView
        android:id="@+id/widget_wbc_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--"
        android:textColor="#f1f5f9"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 24h change -->
    <TextView
        android:id="@+id/widget_wbc_change"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="9sp"
        android:layout_marginBottom="4dp" />

    <!-- 7-day sparkline -->
    <TextView
        android:id="@+id/widget_wbc_sparkline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#475569"
        android:textSize="8sp"
        android:layout_marginBottom="6dp" />

    <!-- Divider label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TOP CONSTITUENTS"
        android:textColor="#334155"
        android:textSize="7sp"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- Top 5 companies -->
    <TextView android:id="@+id/widget_wbc_co1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#e2e8f0" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_wbc_co2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#cbd5e1" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_wbc_co3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#94a3b8" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_wbc_co4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#64748b" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/widget_wbc_co5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />

</LinearLayout>
