<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mc_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">

    <!-- Header row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/widget_mc_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="&#128200; Meme Coins"
            android:textColor="#f59e0b"
            android:textSize="9sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_mc_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#128260; MCap"
                android:textColor="#94a3b8"
                android:textSize="8sp"
                android:paddingEnd="6dp" />

            <TextView
                android:id="@+id/widget_mc_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8635;"
                android:textColor="#f59e0b"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Pager / status line -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_mc_prev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="&#9664;"
            android:textColor="#f59e0b"
            android:textSize="11sp"
            android:paddingEnd="6dp" />

        <TextView
            android:id="@+id/widget_mc_pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="p.1 &#8226; Loading&#8230;"
            android:textColor="#64748b"
            android:textSize="7sp" />

        <TextView
            android:id="@+id/widget_mc_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#9654;"
            android:textColor="#f59e0b"
            android:textSize="11sp"
            android:paddingStart="6dp" />
    </RelativeLayout>

    <!-- Coin row 1 -->
    <LinearLayout android:id="@+id/widget_mc_row1_root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#0D1E3A" android:padding="4dp" android:layout_marginBottom="2dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#e2e8f0" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_mc_row1_chg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#22c55e" android:textSize="8sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row1_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#f59e0b" android:textSize="7sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/widget_mc_row1_extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#475569" android:textSize="6sp" android:maxLines="1" android:ellipsize="end" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Coin row 2 -->
    <LinearLayout android:id="@+id/widget_mc_row2_root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#0D1E3A" android:padding="4dp" android:layout_marginBottom="2dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#e2e8f0" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_mc_row2_chg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#22c55e" android:textSize="8sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row2_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#f59e0b" android:textSize="7sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/widget_mc_row2_extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#475569" android:textSize="6sp" android:maxLines="1" android:ellipsize="end" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Coin row 3 -->
    <LinearLayout android:id="@+id/widget_mc_row3_root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#0D1E3A" android:padding="4dp" android:layout_marginBottom="2dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#e2e8f0" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_mc_row3_chg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#22c55e" android:textSize="8sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row3_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#f59e0b" android:textSize="7sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/widget_mc_row3_extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#475569" android:textSize="6sp" android:maxLines="1" android:ellipsize="end" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Coin row 4 -->
    <LinearLayout android:id="@+id/widget_mc_row4_root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#0D1E3A" android:padding="4dp" android:layout_marginBottom="2dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row4_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#e2e8f0" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_mc_row4_chg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#22c55e" android:textSize="8sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row4_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#f59e0b" android:textSize="7sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/widget_mc_row4_extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#475569" android:textSize="6sp" android:maxLines="1" android:ellipsize="end" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Coin row 5 -->
    <LinearLayout android:id="@+id/widget_mc_row5_root" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:background="#0D1E3A" android:padding="4dp">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row5_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#e2e8f0" android:textSize="8sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_mc_row5_chg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#22c55e" android:textSize="8sp" android:textStyle="bold" />
        </RelativeLayout>
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/widget_mc_row5_price" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true" android:text="" android:textColor="#f59e0b" android:textSize="7sp" android:fontFamily="monospace" />
            <TextView android:id="@+id/widget_mc_row5_extra" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="" android:textColor="#475569" android:textSize="6sp" android:maxLines="1" android:ellipsize="end" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
