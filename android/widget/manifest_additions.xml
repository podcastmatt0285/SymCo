<!--
  Add this <receiver> block inside the <application> tag in
  app/src/main/AndroidManifest.xml, just before </application>.

  Replace PACKAGE_NAME with your actual package (e.g. cc.notifly.wadsworth).
-->

<receiver
    android:name="PACKAGE_NAME.WadsworthWidget"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/wadsworth_widget_info" />
</receiver>

<receiver
    android:name="PACKAGE_NAME.MemeCoinsWidget"
    android:exported="true">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="PACKAGE_NAME.MEMECOINS_REFRESH" />
        <action android:name="PACKAGE_NAME.MEMECOINS_NEXT" />
        <action android:name="PACKAGE_NAME.MEMECOINS_PREV" />
        <action android:name="PACKAGE_NAME.MEMECOINS_SORT" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/memecoins_widget_info" />
</receiver>

<!--
  Also add this permission near the top of AndroidManifest.xml
  (inside <manifest>, outside <application>):

  <uses-permission android:name="android.permission.INTERNET" />

  (Bubblewrap should already have this — if it does, skip it.)
-->
