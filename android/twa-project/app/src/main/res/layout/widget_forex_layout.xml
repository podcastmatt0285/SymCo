<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_forex_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_forex_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="&#128177; Forex Rates"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_forex_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#8635;"
            android:textColor="#38bdf8"
            android:textSize="13sp" />

    </RelativeLayout>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/widget_forex_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="vs USD  &#8226;  Loading&#8230;"
        android:textColor="#334155"
        android:textSize="7sp"
        android:textStyle="bold"
        android:layout_marginBottom="3dp" />

    <!-- Currency pair rows (up to 8) -->
    <TextView android:id="@+id/widget_forex_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#e2e8f0" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#cbd5e1" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#94a3b8" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#94a3b8" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#64748b" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#64748b" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row7" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_forex_row8" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />

</LinearLayout>
