<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bonds_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/widget_bonds_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="&#128200; Bond Yields"
            android:textColor="#38bdf8"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_bonds_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#8635;"
            android:textColor="#38bdf8"
            android:textSize="13sp" />

    </RelativeLayout>

    <!-- Divider label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CURRENCY  YIELD  24H CHANGE  7D CHART"
        android:textColor="#334155"
        android:textSize="7sp"
        android:textStyle="bold"
        android:layout_marginBottom="3dp" />

    <!-- Bond rate rows (up to 8 currencies) -->
    <TextView android:id="@+id/widget_bond_row1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#e2e8f0" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#cbd5e1" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#94a3b8" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row4" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#94a3b8" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#64748b" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#64748b" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row7" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />
    <TextView android:id="@+id/widget_bond_row8" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#475569" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="monospace" />

    <!-- Footer -->
    <TextView
        android:id="@+id/widget_bonds_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#334155"
        android:textSize="7sp"
        android:layout_marginTop="4dp" />

</LinearLayout>
