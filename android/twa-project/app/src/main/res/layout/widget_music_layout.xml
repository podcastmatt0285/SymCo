<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_music_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:gravity="center_horizontal"
    android:background="@drawable/widget_background">

    <!-- Header row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/widget_music_station"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:text="WCPR 104.1"
            android:textColor="#38bdf8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_music_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="&#8635;"
            android:textColor="#38bdf8"
            android:textSize="13sp" />

    </RelativeLayout>

    <!-- Full station name -->
    <TextView
        android:id="@+id/widget_music_slogan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wadsworth Carter Public Radio"
        android:textColor="#94a3b8"
        android:textSize="8sp"
        android:layout_marginBottom="2dp" />

    <!-- Frequency -->
    <TextView
        android:id="@+id/widget_music_freq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="104.1 FM"
        android:textColor="#64748b"
        android:textSize="8sp"
        android:layout_marginBottom="8dp" />

    <!-- ON AIR badge -->
    <TextView
        android:id="@+id/widget_music_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ON AIR"
        android:textColor="#22c55e"
        android:textSize="8sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <!-- Play button -->
    <TextView
        android:id="@+id/widget_music_play_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="&#9654; Open Player"
        android:textColor="#0f172a"
        android:textSize="10sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#38bdf8"
        android:padding="6dp" />

</LinearLayout>
