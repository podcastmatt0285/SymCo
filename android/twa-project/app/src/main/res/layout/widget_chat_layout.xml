    <TextView android:id="@+id/widget_chat_msg5" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#e2e8f0" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />

    <!-- Messages 6-10 -->
    <TextView android:id="@+id/widget_chat_msg6" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textColor="#cbd5e1" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
