__pycache__/
*.pyc
*.pyo
*.db
*.sqlite

# SQL dump files — too large to store in git; use backup.sh to manage these
*.sql
counties_backup.sql
reserve_banks_backup.sql
wadsworth_backup.sql
.vapid_keys.json
venv/
.venv/

# Android build output — regenerated from scratch on every build
android/twa-project/

# Runtime state files
widget_devices.json
nohup.out
Task
cloudflared.log
tick_state.txt

# Dev-only / scratch files
cheat.txt

# Claude helper session files — never commit these
claudeHelper/

# Runtime secrets — never commit
.env

# Google Play service account key — lives at /etc/wadsworth/play-service-account.json
# NEVER commit service account JSON keys
*service-account*.json

# Keep intentional DB backup SQL files in the backups/ folder tracked
!backups/*.sql
!backups/.gitkeep

# Large media / binary assets — not needed in git
*.mp4
*.apk
*.aab
