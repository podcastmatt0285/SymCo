__pycache__/
*.pyc
*.pyo
*.db
*.sqlite
.vapid_keys.json
venv/
.venv/

# Android build output — regenerated from scratch on every build
android/twa-project/

# Runtime state files
widget_devices.json
# Generated, skin-themed player snapshot OG cards (regenerated on demand, one per player)
static/cache/
nohup.out
Task
cloudflared.log
tick_state.txt

# Dev-only / scratch files
cheat.txt

# Claude helper session files — never commit these
claudeHelper/

# Runtime secrets — never commit
.env

# Google Play service account key — lives at /etc/wadsworth/play-service-account.json
# NEVER commit service account JSON keys
*service-account*.json

# Raw SQL dumps are too large (~46 MB) — backup.sh now writes gzip-compressed
# .sql.gz files (~3-5 MB) instead. Track those, ignore raw .sql files.
*.sql
!backups/*.sql
!backups/.gitkeep

# Large media / binary assets — not needed in git
*.mp4
*.apk
*.aab

# Daily backup cron log (install-backup-cron.sh)
backup.log
